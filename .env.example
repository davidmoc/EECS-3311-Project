# .env.example - contains no real credentials.
# Copy to .env and fill in your own key:  cp .env.example .env
OPENAI_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Any chat-capable model your key can access. A mini-tier model is enough.
OPENAI_MODEL=gpt-5-mini

# Optional: point at another OpenAI-compatible provider.
# OPENAI_BASE_URL=

# Optional: where the local SQLite database is stored.
# PRAXIS_DATABASE_PATH=data/praxis.db

# Optional: set to "off" to stop Praxis looking beyond the library (web
# search and Wikipedia) for texts on what you research or study.
# PRAXIS_WEB_DISCOVERY=on
